{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "functions": {
    "app/.well-known/workflow/v1/**": {
      "maxDuration": 300
    }
  },
  "env": {
    "BENCHMARK_HOSTED": "1"
  }
}
