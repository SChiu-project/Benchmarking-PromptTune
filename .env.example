DOC_SEARCH_ENDPOINT=https://dev.setsailapi.com/nlp/rag/docSearchConvo
DOC_SEARCH_PROJECT_ID=mtr-air-kiosk-05emf61
DOC_SEARCH_TIMEOUT_MS=60000
# Full OpenAI-compatible chat-completions URL (not a base URL).
EVALUATOR_ENDPOINT=
EVALUATOR_MODEL=
EVALUATOR_API_KEY=
EVALUATOR_TIMEOUT_MS=60000
# Optional absolute data directory. Default: ./data
# DATA_DIR=
PORT=3000

# Hosting: Vercel always uses PostgreSQL + durable Workflows.
# Use a pooled Neon/PostgreSQL connection URL with TLS enabled.
DATABASE_URL=
# Required on Vercel; shared workspace password (at least 16 characters).
APP_USERNAME=benchmark
APP_PASSWORD=
# Optional custom domain, e.g. https://benchmark.example.com
APP_URL=
# Optional override. Otherwise production and preview namespaces are separate.
BENCHMARK_NAMESPACE=
# Local testing only: workflow switches from the local process worker to Workflow SDK.
# JOB_BACKEND=workflow

# Optional read-only CMS prompt loading. Project IDs are a required server-side allowlist.
CMS_PROJECT_IDS=
CMS_GRAPH_BASE_URL=https://dev.setsailapi.com/nlp/llmGraph
CMS_READ_TIMEOUT_MS=15000
# Verified CMS user-session headers; update both when the session expires. Never NEXT_PUBLIC_*.
CMS_READ_TOKEN=
CMS_READ_UID=
# Local only: explicit path to the CMS connector session file. Ignored on hosted deployments.
# CMS_SESSION_FILE=/absolute/path/to/cms-mcp/session.json
